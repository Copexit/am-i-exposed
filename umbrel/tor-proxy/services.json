  "services": [
    {
      "id": "wabisator",
      "name": "Wabisator",
      "kind": "data-provider",
      "homepage": "https://wabisator.com",
      "base": "https://wabisator.com",
      "routes": [
        {
          "path": "/api.php",
          "http": "POST",
          "rpc": {
            "dashboard": {
              "class": "aggregate",
              "ttl": 60
            },
            "coordinators-status": {
              "class": "aggregate",
              "ttl": 15
            },
            "flow-map": {
              "class": "aggregate",
              "ttl": 60
            },
            "volume-history": {
              "class": "aggregate",
              "ttl": 600
            },
            "rounds-paginated": {
              "class": "aggregate",
              "ttl": 60
            },
            "coinjoin": {
              "class": "lookup",
              "params": {
                "txId": "txid"
              }
            },
            "search": {
              "class": "lookup",
              "params": {
                "query": "txid"
              }
            }
          }
        }
      ]
    },
